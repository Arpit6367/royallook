// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // or postgresql
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COACH
  STUDENT
}

enum Stage {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(STUDENT)
  
  // Student Specifics
  stage     Stage    @default(BEGINNER)
  coachId   String?
  coach     User?    @relation("CoachStudents", fields: [coachId], references: [id])
  students  User[]   @relation("CoachStudents") // For Coaches

  assignments Assignment[]
  progress    Progress[]
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  
  // Hierarchy
  stage     Stage?   // Only root folders have a stage
  parentId  String?
  parent    Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("SubFolders")
  
  puzzles   Puzzle[]
}

model Puzzle {
  id          String   @id @default(uuid())
  title       String
  fen         String   @db.Text
  solution    String   @db.Text // Space separated moves "e4 e5 Nf3"
  
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  assignments Assignment[]
  progress    Progress[]
}

model Assignment {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  puzzleId    String
  puzzle      Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  
  assignedBy  String   // Name/ID of Coach/Admin
  isCompleted Boolean  @default(false)
  assignedAt  DateTime @default(now())
}

model Progress {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  puzzleId    String
  puzzle      Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  isSolved    Boolean  @default(false)
  attempts    Int      @default(0)
  timeSpent   Int      @default(0) // Seconds
  mistakes    Json     @default("[]") // Array of wrong move strings
  
  lastPlayed  DateTime @updatedAt
  
  @@unique([studentId, puzzleId])
}