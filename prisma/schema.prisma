// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // use postgresql for Vercel Postgres / Neon
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COACH
  STUDENT
}

enum Stage {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(STUDENT)

  // Student-specific
  stage     Stage    @default(BEGINNER)
  coachId   String?
  coach     User?    @relation("CoachStudents", fields: [coachId], references: [id], onDelete: SetNull)
  students  User[]   @relation("CoachStudents") // for Coaches

  assignments Assignment[]
  progress    Progress[]
}

model Folder {
  id        String   @id @default(uuid())
  name      String

  stage     Stage?   // only root folders have stage
  parentId  String?
  parent    Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("SubFolders")

  puzzles   Puzzle[]
}

model Puzzle {
  id        String   @id @default(uuid())
  title     String
  fen       String   @db.Text
  solution  String   @db.Text // space separated moves

  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  assignments Assignment[]
  progress    Progress[]
}

model Assignment {
  id          String   @id @default(uuid())

  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  puzzleId    String
  puzzle      Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  assignedBy  String
  isCompleted Boolean  @default(false)
  assignedAt  DateTime @default(now())
}

model Progress {
  id          String   @id @default(uuid())

  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  puzzleId    String
  puzzle      Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  isSolved    Boolean  @default(false)
  attempts    Int      @default(0)
  timeSpent   Int      @default(0)

  mistakes    Json     @default("[]") // postgres supports JSON defaults

  lastPlayed  DateTime @updatedAt

  @@unique([studentId, puzzleId])
}
